KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD={{ secrets.admin_password }}
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:{{ db_port }}/keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD={{ secrets.db_password }}
KC_HOSTNAME={{ kc_url }}
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_HTTP_HOST=127.0.0.1
KC_HTTP_PORT={{ kc_http_port }}
KC_HTTPS_HOST=127.0.0.1
KC_HTTPS_PORT={{ kc_https_port }}
KC_HTTP_MANAGEMENT_HOST=127.0.0.1
KC_HTTP_MANAGEMENT_PORT={{ kc_management_port }}
KC_HTTPS_CERTIFICATE_FILE=/etc/certs/server.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/etc/certs/server.key
KC_TRUSTSTORE_PATHS=/etc/certs/ca.crt
KC_LOG_LEVEL=INFO
