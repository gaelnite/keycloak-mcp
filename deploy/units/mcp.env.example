# Environment for keycloak-mcp-server.service
# Copy to ~/.config/keycloak-mcp/mcp.env, chmod 600, and replace /home/you with
# your home directory (systemd EnvironmentFile does not expand $HOME).
# The entity map lives in the unit as Environment= because systemd's
# EnvironmentFile parser mangles JSON containing braces and quotes.
KC_URL=https://localhost:8443
KC_ISSUER=https://localhost:8443/realms/lab
KC_AUDIENCE=https://localhost:8800/mcp
# One CIMD URL per line (preferred over the comma env form):
KC_ALLOWED_CLIENT_IDS_FILE=/home/you/.config/keycloak-mcp/allowed-clients.txt
KC_EXTENSIONS=metrics,magic-link
KC_METRICS_URL=https://localhost:9000/metrics
KC_HEALTH_URL=https://localhost:9000/health/ready
KC_MCP_AUDIT_LOG=/home/you/.local/state/keycloak-mcp/authz-audit.jsonl
SSL_CERT_FILE=/home/you/.config/keycloak-mcp/certs/ca.crt
KC_CEDAR_TIMEOUT_MS=500
